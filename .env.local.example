NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: "ask the chef" (Google Gemini). The chef always calls gemini-1.5-flash; a GEMINI_MODEL
# variable, if one is still set in the project settings, is ignored.
GEMINI_API_KEY=

# Optional: enables /api/quick-add (iOS Shortcuts). Long random string; every call must send it as ?token=...
# Without it the endpoint stays closed (503).
QUICK_ADD_TOKEN=
