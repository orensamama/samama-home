NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: "ask the chef" (Google Gemini). GEMINI_MODEL overrides the default model (gemini-1.5-flash);
# if Google reports a model as retired (404) the chef discovers a working "flash" model by itself.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: enables /api/quick-add (iOS Shortcuts). Long random string; every call must send it as ?token=...
# Without it the endpoint stays closed (503).
QUICK_ADD_TOKEN=
